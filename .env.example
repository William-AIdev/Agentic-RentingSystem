# App
APP_TITLE="Rental Agent"
APP_HOST="0.0.0.0"
APP_PORT=7860
LOG_LEVEL="INFO"

# Timezone (default: Australia/Sydney)
LOCAL_TIMEZONE="Australia/Sydney"

# LLM configuration

# leave empty to use OpenAI's API, otherwise set to your custom model URL
# CUSTOM_MODEL_BASE_URL="input_your_custom_model_url_here"

# if using custom model, set this API key for authentication (if required)
OPENAI_API_KEY="input_your_openai_api_key_here"
OPENAI_MODEL="gpt-5-nano"

# Dont need to change if using OpenAI compatible model
MODEL_PROVIDER="openai"

# gpt-5-nano only supports temperature 1
OPENAI_TEMPERATURE=1

# LangSmith (Optional)
LANGSMITH_API_KEY="your_langsmith_api_key"

# Postgres (used by app + docker-compose)
POSTGRES_HOST="db"
POSTGRES_PORT=5432
POSTGRES_USER="rental"
POSTGRES_PASSWORD="rental_pwd"
POSTGRES_DB="rental_db"
DB_POOL_SIZE=5

# Vector store (Qdrant)
QDRANT_URL="http://qdrant:6333"
QDRANT_COLLECTION="rental_rules"
RAG_RECREATE=false
RAG_TOP_K=3
RAG_DENSE_K=6
RAG_BM25_K=6
RAG_RERANK_CANDIDATES=6

# Embeddings
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
EMBEDDING_NORMALIZE=true

# Hybrid retrieval reranker (disabled by default for CPU-only deployments)
ENABLE_RERANKER=false
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
RERANKER_USE_FP16=false
RERANKER_PASSAGE_CHARS=800

# Rules path
RULES_PATH="agent/rules/rental_rules.md"
